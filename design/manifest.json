  "libraries": [],
  "components": [
    {
      "name": "Button",
      "group": "Actions",
      "summary": "The action control: one primary button per view for the most useful next step, with secondary buttons for alternatives."
    },
    {
      "name": "ServeButton",
      "group": "SymphoServe",
      "summary": "SymphoServe's product button, matching the shadcn-svelte Button in the admin portal and product owner dashboard."
    },
    {
      "name": "ServeDataTable",
      "group": "SymphoServe",
      "summary": "A dense, scannable table for SymphoServe operational records (orders, bills, audit entries), inside a bordered white panel."
    },
    {
      "name": "ServeKdsTicket",
      "group": "SymphoServe",
      "summary": "The kitchen display (KDS) order ticket (KOT card): status-first, high-contrast and touch-sized, shown on the dark kitchen board."
    },
    {
      "name": "ServePageHeader",
      "group": "SymphoServe",
      "summary": "The top of every SymphoServe product page: an optional eyebrow, the page title, a one-sentence description and right-aligned actions."
    },
    {
      "name": "ServeSidebar",
      "group": "SymphoServe",
      "summary": "The persistent forest navigation of the SymphoServe admin portal and product owner dashboard."
    },
    {
      "name": "ServeStatCard",
      "group": "SymphoServe",
      "summary": "A compact metric tile for SymphoServe dashboards: label, value, optional helper line and optional icon chip."
    },
    {
      "name": "ServeStatusBadge",
      "group": "SymphoServe",
      "summary": "An inline operational status label with a dot, coloured by the serve-status-* tokens, for orders, tables, bills and print jobs."
    },
    {
      "name": "TextField",
      "group": "Forms",
      "summary": "A labelled single-line input with an inline required marker, optional help text, and error and success states."
    },
    {
      "name": "ZenDashboard",
      "group": "SymphoZen Command",
      "summary": "The reference SymphoZen Command screen — Employee Management — composed from ZenSidebar, the top bar, ZenPageHeader, ZenMetricCard, ZenDataTable and ZenStatusB…",
      "page": true
    },
    {
      "name": "ZenDataTable",
      "group": "SymphoZen Command",
      "summary": "The SymphoZen Command data panel: segmented tabs, a toolbar, a selectable table with rich cells, and pagination."
    },
    {
      "name": "ZenMetricCard",
      "group": "SymphoZen Command",
      "summary": "A KPI tile — label, large value, trend and caption — matching the package's MetricCard with the Command icon tile on the left."
    },
    {
      "name": "ZenPageHeader",
      "group": "SymphoZen Command",
      "summary": "The heading block of a SymphoZen Command page: an icon tile, title, one-line description and the page's single primary action."
    },
    {
      "name": "ZenSidebar",
      "group": "SymphoZen Command",
      "summary": "The SymphoZen Command navigation rail: product lockup, collapsible sections with Lucide icons, the open section's children, and the signed-in user."
    },
    {
      "name": "ZenStatusBadge",
      "group": "SymphoZen Command",
      "summary": "The shared status and category pill from @symphozenlabs/ui (StatusBadge over Badge variant=\"outline\"), with a dot for states."
    }
  ],
