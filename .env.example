# Copy to .env for local development. Without the service keys, `npm run dev`
# uses an in-memory stand-in (data resets on restart) and logs emails to the
# terminal; a production deployment refuses registrations until they are set.

# Admin dashboard sign-in (/admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Neon → your project → Connect → connection string
DATABASE_URL=

# Cloudflare R2 → your bucket → Settings → S3 API (includes the bucket name)
R2_S3_API_URL=
# R2 → Manage API tokens → token with "Object Read & Write" on that bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Resend → API Keys; the sender must be on a domain verified in Resend
RESEND_API_KEY=
EMAIL_FROM=
